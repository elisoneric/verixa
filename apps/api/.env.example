# ==========================================
# VERIXA ID - Backend API Environment Variables
# ==========================================

# Server Configuration
PORT=3003
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=verixa
DB_PASSWORD=verixa_password
DB_NAME=verixa_db

# Cache & Idempotency Store (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_jwt_secret_at_least_32_chars
SYSTEM_ENCRYPTION_KEY=replace_with_exact_32_char_key_for_encrypting_provider_creds

# Google OAuth 2.0 (Google Identity Services GIS)
# Client ID obtained from Google Cloud Console (OAuth 2.0 Client IDs for Web application)
# Must match NEXT_PUBLIC_GOOGLE_CLIENT_ID configured on the frontend
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Paystack (Dedicated Virtual Accounts & Automated Settlement)
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here

# Upstream Identity Verification Provider (Dojah / Upstream Registry)
# App ID and Secret Key obtained from Dojah Developer Portal
DOJAH_APP_ID=your_dojah_app_id
DOJAH_SECRET_KEY=your_dojah_secret_key
DOJAH_ENVIRONMENT=production # or sandbox
# Note: vx_APP_ID, vx_SECRET_KEY, vx_ENVIRONMENT are also supported as aliases

# Super Administrator Accounts (Grants SuperAdmin access to Admin Portal)
ADMIN_EMAILS=admin@verixaid.com,elisoneric@gmail.com

# Notifications & Transactional Mail (SMTP)
SMTP_HOST=mail.verixaid.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@verixaid.com
SMTP_PASS=your_smtp_password
SMTP_FROM_NAME=Verixa ID
SMTP_FROM_EMAIL=no-reply@verixaid.com
