# ==========================================
# VERIXA ID - Dashboard Frontend Environment Variables
# ==========================================

# Backend API Endpoint
# Development: http://localhost:3003
# Production: https://api-verixa.esam.com.ng
NEXT_PUBLIC_API_URL=http://localhost:3003

# Google OAuth 2.0 Web Client ID
# Created in Google Cloud Console under Credentials > OAuth 2.0 Client IDs
# Authorized JavaScript origins must include your dashboard domain(s):
# e:g., http://localhost:3001, https://verixa.esam.com.ng
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
